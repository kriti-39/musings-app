rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return isAuth() && role() == 'admin'; }
    function isTeacher() { return isAuth() && role() == 'teacher'; }
    function isAdminOrTeacher() { return isAdmin() || isTeacher(); }

    // The signed-in person's own profile, for the rules that depend on how the
    // studio has set them up (billingMode, isActive) rather than on what their
    // browser claims.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Is this time inside the studio's teaching hours?
    //
    // The booking screen only OFFERS times inside them, but a screen is not a
    // rule: without this a student could write a class for three in the
    // morning straight from a browser console. The hours live in
    // settings/teaching as minutes from midnight per weekday, in the studio's
    // own zone; `offsetMinutes` is that zone's distance from UTC, stored
    // alongside because rules cannot look a timezone up. With no document at
    // all the default applies: six in the morning to midnight, every day.
    //
    // A class must END by closing time, which is how midnight stays a closing
    // hour and never becomes a starting one.
    function teachingAllows(start, mins) {
      let p = /databases/$(database)/documents/settings/teaching;
      let t = exists(p) ? get(p).data : {};
      let offset = ('offsetMinutes' in t) ? t.offsetMinutes : 330;
      let local = start + duration.value(offset, 'm');
      let key = string(local.dayOfWeek() == 7 ? 0 : local.dayOfWeek());
      let from = local.hours() * 60 + local.minutes();
      return ('hours' in t)
        ? (key in t.hours && t.hours[key] != null
            && from >= t.hours[key].open && from + mins <= t.hours[key].close)
        : (from >= 360 && from + mins <= 1440);
    }

    // Once this request has committed, does the class hold the lock on the
    // i-th quarter hour from `start`?
    //
    // getAfter() reads the lock as the transaction LEAVES it, which is what
    // makes this checkable at all: the class and its locks are written
    // together, so neither exists yet when the other's rule runs. Requiring it
    // is what ties a class to its slot. Before this, the locks were a
    // convention the app followed, and a class written by hand simply did not
    // bother with them.
    function holdsLock(teacherId, start, i, classId) {
      return getAfter(/databases/$(database)/documents/slotLocks/$(teacherId + '_' + string(start.toMillis() / 900000 + i))).data.classId == classId;
    }

    function isStaffUser(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role in ['admin', 'teacher'];
    }

    match /users/{userId} {
      // A user can read their own profile; staff can read everyone; and ANY
      // signed-in user can read staff (admin/teacher) profiles — students need
      // this to discover the teacher (timezone, id) and to notify staff when
      // they book. Queries are role-constrained, so students still cannot read
      // other students' profiles.
      allow read: if isAuth() && (
        request.auth.uid == userId
        || isAdminOrTeacher()
        || resource.data.role in ['admin', 'teacher']
      );
      allow create: if isAdminOrTeacher();

      // A person may edit their OWN profile, but only the parts that are
      // genuinely theirs. Everything that decides money or power stays with
      // staff: `role` (these very rules call role() to decide who is an
      // admin, so writing it is privilege escalation), `billingMode` (set it
      // to legacy and you book without credits forever), `feeAmount` and
      // `feeType` (set your fee to ₹1 and buy four credits for 25 paise), and
      // `isActive` (un-pause your own suspended account).
      //
      // Before this, the rule was simply "you may write to your own document",
      // which was harmless when a profile held only a name and a phone number
      // and became a hole the moment it started deciding prices.
      allow update: if isAuth() && (
        isAdminOrTeacher()
        || (
          request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'phone', 'gender', 'timezone',
            'notifReminderMinutes', 'fcmTokens', 'hasPhoto', 'updatedAt'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // ─── Classes ───────────────────────────────────────────────────────────────
    // Every signed-in user can READ a class document, and that is deliberate:
    // the slot-lock transaction has to look up whoever currently holds a time in
    // order to refuse a double booking, which means reading a class belonging to
    // somebody else. The booking calendar needs the same thing to grey out busy
    // slots.
    //
    // So this document carries SCHEDULING FACTS ONLY. Anything written about a
    // student — Guruji's lesson notes, the recording link and its passcode —
    // lives in the `detail` subcollection below, which only that student and
    // staff can read. Putting them here made every student's notes and class
    // recordings readable by all 92 students.
    match /classes/{classId} {
      allow read: if isAuth();

      // What a student may book for themselves. Without these checks a student
      // could write their own class document straight from a browser console:
      // free of charge, at any time, of any length.
      // Note on style: every optional field is reached through `'x' in d` first.
      // Reading a field that is absent is an ERROR in rules, not null, and an
      // error denies the whole write — so a bare `d.missed != true` refused
      // every booking ever made, because a new class has no `missed` field.
      // That mistake fails closed, which is the safe direction, but it fails
      // closed on the paying customer.
      function studentBooking() {
        let d = request.resource.data;
        let p = me();
        let onCredits = ('billingMode' in p) && p.billingMode == 'credits';
        return d.studentId == request.auth.uid
          // A paused account cannot book. The payment endpoint already refuses
          // them; this is the same answer for the free path.
          && (!('isActive' in p) || p.isActive != false)
          // Booked classes start life scheduled — never completed, never
          // already marked done, never pre-flagged.
          && d.status == 'scheduled'
          && (!('markedDoneBy' in d) || d.markedDoneBy == null)
          && (!('missed' in d) || d.missed != true)
          && (!('creditReviewNeeded' in d) || d.creditReviewNeeded != true)
          // In the future, and inside the booking window. Students book the
          // week ahead; staff schedule further out, which is why this sits in
          // the student branch only.
          && d.scheduledAt is timestamp
          && d.scheduledAt > request.time
          && d.scheduledAt < request.time + duration.value(7, 'd')
          // The three lengths the studio teaches, and nothing else. This was
          // 15 to 180, which let one credit buy a three-hour class from the
          // console although the screen only ever offered an hour.
          && d.duration is int && d.duration in [30, 45, 60]
          // On the quarter hour, inside teaching hours.
          && d.scheduledAt.toMillis() % 900000 == 0
          && d.teacherId is string
          && teachingAllows(d.scheduledAt, d.duration)
          // And actually holding its slot: two quarter hours for the shortest
          // class, three for 45 minutes, four for the hour.
          && holdsLock(d.teacherId, d.scheduledAt, 0, classId)
          && holdsLock(d.teacherId, d.scheduledAt, 1, classId)
          && (d.duration < 45 || holdsLock(d.teacherId, d.scheduledAt, 2, classId))
          && (d.duration < 60 || holdsLock(d.teacherId, d.scheduledAt, 3, classId))
          // A credit student must name a credit batch that is really theirs.
          // Students on the old arrangement book without one. billingMode is
          // staff-only, so neither branch can be chosen by the student.
          && (
            onCredits
              ? (
                ('paidWith' in d) && d.paidWith == 'credit'
                && ('creditBatchId' in d) && d.creditBatchId is string
                && exists(/databases/$(database)/documents/credits/$(d.creditBatchId))
                && get(/databases/$(database)/documents/credits/$(d.creditBatchId)).data.studentId == request.auth.uid
              )
              : (!('paidWith' in d) || d.paidWith == null)
          );
      }

      // The only changes a student may make to their own class. Each is one of
      // the three things the app actually offers them, and nothing else gets
      // through — in particular a student can never set a class back to
      // `scheduled`, which is what made reviving a cancelled class and
      // self-approving a reschedule possible.
      function studentClassChange() {
        let before = resource.data;
        let after = request.resource.data;
        let changed = after.diff(before).affectedKeys();
        return before.studentId == request.auth.uid
          && after.studentId == before.studentId
          && (
            // 1. Call it off, or withdraw a request they already sent.
            (
              changed.hasOnly(['status', 'updatedAt'])
              && after.status == 'cancelled'
              && before.status in ['scheduled', 'pending']
            )
            // 2. Flag their own cancellation for staff to decide the credit.
            //    Raising the flag is theirs; clearing it is not — clearing it
            //    is how a student could make their own cancellation free.
            || (
              changed.hasOnly(['creditReviewNeeded', 'creditReviewReason', 'updatedAt'])
              && after.creditReviewNeeded == true
            )
            // 3. Ask to move it. It goes to `pending` for staff to confirm, and
            //    the new time obeys the same window as a fresh booking.
            || (
              changed.hasOnly(['scheduledAt', 'status', 'updatedAt'])
              && after.status == 'pending'
              && before.status in ['scheduled', 'pending']
              && after.scheduledAt is timestamp
              && after.scheduledAt > request.time
              && after.scheduledAt < request.time + duration.value(7, 'd')
              // The new time answers to the same rules as a fresh booking:
              // quarter hour, teaching hours, and the slot really taken.
              && after.scheduledAt.toMillis() % 900000 == 0
              && teachingAllows(after.scheduledAt, before.duration)
              && holdsLock(before.teacherId, after.scheduledAt, 0, classId)
              && (before.duration <= 15 || holdsLock(before.teacherId, after.scheduledAt, 1, classId))
              && (before.duration < 45 || holdsLock(before.teacherId, after.scheduledAt, 2, classId))
              && (before.duration < 60 || holdsLock(before.teacherId, after.scheduledAt, 3, classId))
            )
            // 4. Mark a class that has already happened as done (the app tracks
            //    student and teacher separately so both can confirm), and the
            //    same shape covers the auto-complete sweep every client runs.
            || (
              changed.hasOnly(['status', 'markedDoneBy', 'updatedAt'])
              && after.status == 'completed'
              && after.markedDoneBy in ['student', 'both', 'auto']
              && before.scheduledAt < request.time
            )
          );
      }

      allow create: if isAuth() && (isAdminOrTeacher() || studentBooking());
      allow update: if isAuth() && (isAdminOrTeacher() || studentClassChange());
      allow delete: if isAdminOrTeacher();

      // Lesson notes and the recording (link + passcode). Readable and writable
      // by the student whose class it is, and by staff. Nobody else — this is
      // the whole reason the subcollection exists.
      match /detail/{docId} {
        allow read, write: if isAuth() && (
          isAdminOrTeacher()
          || (
            exists(/databases/$(database)/documents/classes/$(classId))
            && get(/databases/$(database)/documents/classes/$(classId)).data.studentId == request.auth.uid
          )
        );
      }
    }

    // One class per slot. A lock's id is derived from the teacher and the
    // quarter hour, so two bookings for the same time contend for the same
    // document and only one commits — that contention is what actually
    // prevents a double booking, and it happens in the transaction, not here.
    //
    // A lock must name a class, so a student cannot blank one out to erase a
    // slot's protection. Verifying that the named class is really free would
    // need a get() per quarter hour, and a three-hour class claims thirteen of
    // them — past the limit rules allow in one request. The class rules above
    // are what bound a student's writes; this keeps the locks well-formed.
    // A lock says which class holds one quarter hour, who claimed it, and WHEN
    // that quarter hour is. The last of those is checked against the
    // document's own id, so a lock cannot claim to be about a time it is not.
    //
    // That is what makes a live lock safe from being re-pointed. A student may
    // overwrite a lock only if it is theirs already, or STALE: the class it
    // names is gone, is no longer going to happen, or has moved away from this
    // quarter hour. A lock still doing its job belongs to that class and
    // cannot be taken by hand, which was the route to a double booking.
    //
    // (The lock is still written in the same transaction that creates its
    // class, so nothing here looks the NEW class up. The class rule does that
    // from its side with getAfter: see holdsLock.)
    match /slotLocks/{key} {
      function lockShape() {
        let d = request.resource.data;
        return d.classId is string && d.classId != ''
          && d.teacherId is string
          && d.claimedBy == request.auth.uid
          && d.at is timestamp
          && key == d.teacherId + '_' + string(d.at.toMillis() / 900000);
      }

      function lockIsStale() {
        let old = resource.data;
        let p = /databases/$(database)/documents/classes/$(old.classId);
        let c = exists(p) ? get(p).data : null;
        return c == null
          || (('status' in c) && !(c.status in ['scheduled', 'pending']))
          || !(old.at + duration.value(15, 'm') > c.scheduledAt
               && old.at < c.scheduledAt + duration.value(c.duration, 'm'));
      }

      allow read: if isAuth();
      allow create: if isAuth() && lockShape();
      allow update: if isAuth() && lockShape() && (
        resource.data.classId == request.resource.data.classId
        // Locks from before `at` existed carry nothing to judge them by.
        || !('at' in resource.data)
        || isAdminOrTeacher()
        || lockIsStale()
      );
      allow delete: if isAdminOrTeacher();
    }

    // Staff-only working notes about students. Today that is who is regular
    // and who is drifting — kept here rather than on the student's own profile
    // because a student can read their profile, and this is written ABOUT them
    // for the studio, not for them. One document holding every student, so the
    // Students list costs one read rather than ninety.
    //
    // Students are not merely prevented from writing it: they cannot read it
    // at all.
    match /staffOnly/{docId} {
      allow read, write: if isAdminOrTeacher();
    }

    // When the studio teaches. Every signed-in user READS this — a student
    // cannot be shown what is available without knowing what the day is — and
    // only staff write it. It decides nothing about money or access: at worst
    // a wrong value makes a time unbookable, which the slot rules would catch
    // anyway.
    match /settings/{id} {
      allow read: if isAuth();
      allow write: if isAdminOrTeacher();
    }

    // "I have paid by bank transfer — please add my credits."
    //
    // One document per student, keyed by their own id, and that is the whole
    // defence against a flood: rules cannot count documents, but they can tell
    // a create from an update, so a student has exactly one place to write and
    // may write there again only once the last ask has been answered.
    //
    // A request carries an AMOUNT and never a number of credits. hasOnly()
    // refuses any other field, so a student cannot attach a quantity, mark
    // their own request granted, or name who resolved it. What a transfer is
    // worth is decided by staff, and the credits themselves are still created
    // only by staff — nothing here grants anything.
    match /creditRequests/{studentId} {
      function validAsk() {
        let d = request.resource.data;
        let p = me();
        return d.keys().hasOnly(['studentId', 'amount', 'currency', 'note', 'status', 'createdAt'])
          && d.studentId == studentId
          && d.status == 'pending'
          && d.amount is number && d.amount > 0 && d.amount <= 10000000
          && d.currency is string && d.currency.size() <= 8
          && (!('note' in d) || (d.note is string && d.note.size() <= 300))
          && d.createdAt == request.time
          && p.role == 'student'
          && (!('isActive' in p) || p.isActive != false);
      }

      allow read: if isAuth() && (isAdminOrTeacher() || request.auth.uid == studentId);
      allow create: if isAuth() && request.auth.uid == studentId && validAsk();
      allow update: if isAuth() && (
        isAdminOrTeacher()
        || (request.auth.uid == studentId && resource.data.status != 'pending' && validAsk())
      );
      allow delete: if isAdminOrTeacher();
    }

    match /recurringSchedules/{id} {
      allow read: if isAuth() && (isAdminOrTeacher() || resource.data.studentId == request.auth.uid);
      allow write: if isAdminOrTeacher();
    }

    match /availability/{id} {
      allow read: if isAuth();
      allow write: if isAdminOrTeacher();
    }

    // Money is recorded by the studio, or by the payment gateway through the
    // Admin SDK (which bypasses these rules entirely). A student never writes
    // here: they used to, for the old "submit a payment" screen, and that is
    // gone — leaving it open let a student invent a confirmed ₹99,999 payment
    // for themselves and corrupt the fee report.
    match /payments/{id} {
      allow read: if isAuth() && (isAdminOrTeacher() || resource.data.studentId == request.auth.uid);
      allow create, update: if isAdminOrTeacher();
      allow delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isAuth() && (isAdminOrTeacher() || resource.data.userId == request.auth.uid);

      // A student may notify STAFF — they have to, when they book or cancel —
      // but not another student. Unrestricted, this was a way to send any
      // family a convincing "fees overdue, pay this UPI id" message from
      // inside the app they trust.
      //
      // And only so many. Rules cannot count documents, but they can insist on
      // a document's NAME: a student's notification must be called
      // <sender>_<recipient>_<hour>_<n> with n under twenty, so there are only
      // twenty names to use for each member of staff in any hour, and a name
      // already taken cannot be written again. Twenty an hour is far more than
      // booking, moving and cancelling classes ever needs, and a loop stops
      // dead at the twenty-first.
      function studentNotice() {
        let d = request.resource.data;
        return isStaffUser(d.userId)
          && d.seq is int && d.seq >= 0 && d.seq < 20
          && id == request.auth.uid + '_' + d.userId + '_'
                   + string(request.time.toMillis() / 3600000) + '_' + string(d.seq)
          && d.message is string && d.message.size() <= 300
          && d.type is string && d.type.size() <= 40
          && (!('title' in d) || d.title == null || (d.title is string && d.title.size() <= 80))
          && d.isRead == false;
      }

      allow create: if isAuth() && (isAdminOrTeacher() || studentNotice());

      // Marking your own as read, and nothing else — not rewriting what it says.
      allow update: if isAuth() && (
        isAdminOrTeacher()
        || (
          resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['isRead', 'readAt', 'updatedAt'])
        )
      );
      allow delete: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Class credits. Granting, extending and revoking are the studio's to do,
    // but a student has to be able to SPEND one when they book — there is no
    // server in between, so the spend happens from their own device. The update
    // rule below is what makes that safe: a student may change nothing except
    // `used`, may only ever move it up by exactly one, can never take a batch
    // past the quantity that was granted, and cannot touch an expired batch.
    // Everything that decides value — quantity, expiresAt, studentId — is
    // out of their reach entirely.
    match /credits/{id} {
      allow read: if isAuth() && (isAdminOrTeacher() || resource.data.studentId == request.auth.uid);
      allow create: if isAdminOrTeacher();
      allow update: if isAuth() && (
        isAdminOrTeacher()
        || (
          resource.data.studentId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['used', 'status', 'updatedAt'])
          && request.resource.data.used == resource.data.used + 1
          && request.resource.data.used <= resource.data.quantity
          && request.resource.data.status in ['active', 'exhausted']
          && resource.data.status == 'active'
          && resource.data.expiresAt > request.time
        )
      );
      allow delete: if isAdmin();
    }

    // Profile pictures. A student may set and see their own; staff may see and
    // set anyone's. Students deliberately cannot read each other's — the studio
    // holds photographs of children, and there's no reason for one family to be
    // able to pull another's.
    match /photos/{uid} {
      allow read, write: if isAuth() && (request.auth.uid == uid || isAdminOrTeacher());
    }

    // Per-caller request counters, written by the API functions through the
    // Admin SDK, which bypasses these rules. Shut to every client: being able
    // to read them would show who is doing what, and being able to write one
    // would mean resetting your own counter and lifting your own limit. With no
    // rule at all this collection would already be denied by default — saying
    // so explicitly is how the next person knows it was meant to be.
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // Payment receipts are gone — the feature was removed. The rule stays, shut
    // to everyone, because documents from before the removal are still in the
    // database: deleting the rule would fall through to the default deny
    // anyway, but saying so here is clearer than leaving a silent gap.
    match /receipts/{paymentId} {
      allow read, write: if false;
    }
  }
}
